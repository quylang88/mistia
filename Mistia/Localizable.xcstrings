    "app.roottab.theExpenseFlowWillConnectFromThis": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Flow tạo khoản chi sẽ đi từ menu popout này. Hiện tại mình đã chốt interaction để bạn duyệt UI trước."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The expense flow will connect from this popout menu. The interaction is locked in for UI review first."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "支出作成フローはこのポップアウトメニューから接続されます。まずは UI レビュー用に操作感を固定しています。"
          }
        }
      }
    },
    "app.roottab.theIncomeFlowWillConnectFromThis": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Flow thêm thu nhập sẽ nối từ menu này. Hiện tại đang giữ chỗ bằng sheet riêng để state không phải làm lại."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The income flow will connect from this menu. A separate placeholder sheet keeps the state wiring stable for now."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "収入追加フローはこのメニューから接続されます。今は状態管理を崩さないためにプレースホルダーのシートを使っています。"
          }
        }
      }
    },
    "app.roottab.transactions": {
      "localizations": {
