    "family.mistiaprivacy.familySharingIsDesignedToProtectYour" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Family Sharing is designed to protect your information and let you choose what you share."
          }
