    "planning.planning.thisBillWillBeArchivedArchivedBills": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hóa đơn này sẽ bị lưu trữ. Hóa đơn đã lưu trữ sẽ nằm trong \"Mục đã lưu trữ\" và được giữ lại trong 30 ngày."
