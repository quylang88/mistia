    "investment.permission.tradeMessage" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"You do not have permission to buy or sell in this investment portfolio. Request trade access from the data owner."}},"ja":{"stringUnit":{"state":"translated","value":"この投資ポートフォリオで売買する権限がありません。データ所有者に取引権限をリクエストしてください。"}},"vi":{"stringUnit":{"state":"translated","value":"Bạn chưa có quyền mua hoặc bán trong danh mục đầu tư này. Hãy yêu cầu quyền giao dịch từ chủ dữ liệu."}}}},
