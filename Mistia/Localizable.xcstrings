    "management.managementauth.openThisAccountInItsOwnProfile": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở tài khoản này bằng profile riêng, không chuyển dữ liệu guest cũ sang."
          }
        },
        "en": {
          "stringUnit": {
