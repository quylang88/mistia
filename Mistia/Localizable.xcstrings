    "family.family.youAlreadyHavePendingInvitesYou": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đang có 2 lời mời chờ phản hồi. Khi một lời mời hết hạn, bị từ chối, được chấp nhận hoặc thu hồi, bạn có thể tạo link mới."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You already have 2 pending invites. You can create another link after one expires, is declined, accepted, or revoked."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "待機中の招待が2件あります。いずれかが期限切れ、辞退、承認、取り消しになると新しいリンクを作成できます。"
          }
        }
      }
    },
    "family.family.youBecomeTheOwnerAndInviteOthers": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn trở thành chủ sở hữu và mời thêm thành viên sau."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You become the owner and invite others later."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作成者がオーナーになり、あとでメンバーを招待できます。"
          }
        }
      }
    },
    "family.family.youCanCheckWhatFamilyMembersCan": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể kiểm tra những gì các thành viên trong gia đình có thể truy cập hoặc chia sẻ, đồng thời quản lý cài đặt tài khoản của trẻ em và các kiểm soát của phụ huynh."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can check what family members can access or share, while managing child account settings and parental controls."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファミリーメンバーがアクセスまたは共有できるもの確認でき、お子様のアカウント設定と保護者による制限を管理できます。"
          }
        }
      }
    },
    "family.family.youDoNotHaveWalletsToShare": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn chưa có ví nào để chia sẻ quyền chỉnh sửa."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You do not have wallets to share edit access for yet."
