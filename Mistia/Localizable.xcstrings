    "investment.permission.viewMessage" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This portfolio belongs to the member. Only authorized family members can access investment details."}},"ja":{"stringUnit":{"state":"translated","value":"このポートフォリオはメンバーの個人データです。承認されたファミリーメンバーのみが投資情報にアクセスできます。"}},"vi":{"stringUnit":{"state":"translated","value":"Danh mục đầu tư này thuộc quyền riêng tư của thành viên. Cần có sự cho phép để truy cập thông tin."}}}},
    "investment.family.viewAccess" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"View investment portfolio"}},"ja":{"stringUnit":{"state":"translated","value":"投資ポートフォリオの閲覧"}},"vi":{"stringUnit":{"state":"translated","value":"Xem danh mục đầu tư"}}}},
    "investment.family.createAccess" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Record trades & add assets"}},"ja":{"stringUnit":{"state":"translated","value":"取引の記録と資産登録"}},"vi":{"stringUnit":{"state":"translated","value":"Tạo giao dịch & thêm tài sản"}}}},
