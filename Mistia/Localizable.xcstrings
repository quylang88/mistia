    "planning.planning.pauseBillMessage": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hóa đơn này sẽ tạm dừng. Hóa đơn tạm dừng sẽ không xuất hiện trong khoản cần thanh toán, thông báo hoặc tự động thanh toán cho đến khi bắt đầu lại."
