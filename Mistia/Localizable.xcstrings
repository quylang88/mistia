    "transactions.transactioneditor.theValueStatementForThisCardHas": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sao kê %@ của thẻ này đã thanh toán xong. Không thể thêm chi tiêu mới vào kỳ đã đóng."
