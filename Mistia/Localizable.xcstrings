    "management.management.categoryBudgetBranchCurrentMonthBlock": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhánh danh mục này đang được dùng bởi ngân sách tháng hiện tại. Hãy xóa các ngân sách tháng này trước khi đổi tên hoặc cấu trúc."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This category branch is used by a current-month budget. Delete those budgets before changing the name or structure."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このカテゴリ枝は当月の予算で使用されています。名前や構造を変更する前に、その月の予算を削除してください。"
          }
        }
      }
    },
    "management.management.categoryArchiveBlockedHasBills": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể lưu trữ danh mục này vì đang được liên kết với hóa đơn."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot archive this category because it is linked to bills."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "請求書が関連付けられているため、このカテゴリをアーカイブできません。"
          }
        }
      }
    },
    "management.management.categoryArchiveBlockedHasBudgets": {
