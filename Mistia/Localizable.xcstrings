        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiền tệ hiển thị"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Display currency"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示通貨"
          }
        }
      }
    },
    "settings.currency.primaryDescription": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tổng quan, Sắp tới và Gia đình sẽ hiển thị tổng hợp theo tiền tệ này. Thu chi và ví vẫn giữ tiền tệ riêng."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Overview, Upcoming, and Family totals use this currency. Cashflow and wallets keep their own currencies."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "概要、プラン、家族の集計はこの通貨で表示します。取引とウォレットはそれぞれの通貨を保持します。"
          }
        }
      }
    },
    "settings.currency.rateDescription": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi bật tự động, Mistia cập nhật tỷ giá sau 7:00 sáng hoặc khi bạn bấm cập nhật. Khi tắt, Mistia dùng tỷ giá bạn nhập."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When auto-update is on, Mistia refreshes rates after 7:00 AM or when you tap refresh. When it is off, Mistia uses the rate you enter."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動更新をオンにすると、ミスティアは午前7時以降または更新ボタンを押したときにレートを更新します。オフのときは入力したレートを使います。"
          }
        }
      }
    },
    "settings.currency.rateMode": {
      "localizations": {
