    "management.managementauth.youCanAlwaysSignOutDisableSync" : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn luôn có thể đăng xuất, tắt đồng bộ, hoặc xóa tài khoản cloud trong phần Hồ sơ. Dữ liệu local trên thiết bị vẫn được kiểm soát riêng theo các lựa chọn đó."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can always sign out, disable sync, or delete your cloud account from Profile. Local data on your device remains under the control of those choices."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロフィール画面から、ログアウト、同期の無効化、クラウドアカウントの削除をいつでも行えます。ローカルデータはその選択に応じて管理されます。"
          }
        }
      }
    },
    "management.managementauth.youWillBeSignedOutAndThe" : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn sẽ bị đăng xuất và toàn bộ dữ liệu local của profile hiện tại trên máy này sẽ bị xóa. Các profile local khác trên thiết bị vẫn được giữ nguyên."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You will be signed out and the current profile's local data on this device will be deleted. Other local profiles on this device will stay untouched."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ログアウトして、この端末にある現在のプロフィールのローカルデータを削除します。この端末上の他のローカルプロフィールは保持されます。"
          }
        }
      }
    },
    "management.managementauth.youWillBeSignedOutOfMistia" : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn sẽ bị đăng xuất khỏi Mistia trên thiết bị này. Dữ liệu local hiện có vẫn được giữ lại."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You will be signed out of Mistia on this device. Existing local data will stay on the device."
