    "family.mistiaprivacy.familySharingIsDesignedToProtectYour" : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chia sẻ gia đình được thiết kế để bảo vệ thông tin cá nhân của bạn và cho phép bạn chọn những gì mình muốn chia sẻ."
