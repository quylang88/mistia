    "management.management.thisAdjustmentCannotBeUndoneAreYou": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hành động điều chỉnh này sẽ không thể hoàn tác. Bạn có chắc chắn muốn tiếp tục?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This adjustment cannot be undone. Are you sure you want to proceed?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この調整は取り消すことができません。続行してもよろしいですか？"
          }
        }
      }
    },
    "management.management.thisCategoryWillBeArchivedArchivedCategories": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Danh mục này sẽ bị lưu trữ. Các danh mục đã lưu trữ sẽ nằm trong \"Mục đã lưu trữ\" và được giữ lại trong 30 ngày."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This category will be archived. Archived categories will remain in \"Archived items\" for 30 days."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このカテゴリはアーカイブされます。アーカイブされたカテゴリは「アーカイブ済みアイテム」に30日間保持されます。"
          }
        }
      }
    },
    "management.management.thisCreditCardHasOutstandingDebtChanging": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thẻ tín dụng này đang có dư nợ chưa thanh toán. Thay đổi ví nguồn thanh toán có thể ảnh hưởng đến việc theo dõi sao kê. Bạn có chắc muốn tiếp tục?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This credit card has outstanding debt. Changing the payment source wallet may affect statement tracking. Are you sure you want to continue?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このクレジットカードには未払いの債務があります。支払い元ウォレットを変更すると明細の追跡に影響する可能性があります。続行してもよろしいですか？"
          }
        }
      }
    },
    "management.management.thisParentCategoryStillHasActiveChild": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Danh mục cha này vẫn còn danh mục con đang hoạt động. Hãy lưu trữ hoặc chuyển các danh mục con trước."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This parent category still has active child categories. Archive or move those child categories first."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
