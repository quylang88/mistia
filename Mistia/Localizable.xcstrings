    "management.managementauth.mistiaAlreadyHasTheSignInAnd" : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mistia đã có sẵn flow đăng nhập và đồng bộ, nhưng bạn cần điền URL cùng public key của dịch vụ cloud trước khi dùng."
          }
        },
        "en" : {
          "stringUnit" : {
