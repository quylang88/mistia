    "management.managementauth.importTheFileAndLetSnapshotValues": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập file và ưu tiên dữ liệu trong snapshot khi trùng ID, nhưng vẫn giữ các mục local khác."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import the file and let snapshot values win on matching IDs while keeping unrelated local records."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ ID はスナップショット側を優先しつつ、関係ないローカルレコードは維持して読み込みます。"
          }
        }
      }
