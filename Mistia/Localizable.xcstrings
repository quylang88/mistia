        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When sync conflicts or review-needed data appear, you will manage them here."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同期競合や確認が必要なデータが発生したら、ここで管理できます。"
          }
        }
      }
    },
    "management.managementauth.youCanAlwaysSignOutDisableSync": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn luôn có thể đăng xuất, tắt đồng bộ, hoặc xóa tài khoản cloud trong phần Hồ sơ. Dữ liệu local trên thiết bị vẫn được kiểm soát riêng theo các lựa chọn đó."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can always sign out, disable sync, or delete your cloud account from Profile. Local data on your device remains under the control of those choices."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロフィール画面から、ログアウト、同期の無効化、クラウドアカウントの削除をいつでも行えます。ローカルデータはその選択に応じて管理されます。"
          }
        }
      }
    },
    "management.managementauth.youWillBeSignedOutAndThe": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn sẽ bị đăng xuất và toàn bộ dữ liệu local của profile hiện tại trên máy này sẽ bị xóa. Các profile local khác trên thiết bị vẫn được giữ nguyên."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You will be signed out and the current profile's local data on this device will be deleted. Other local profiles on this device will stay untouched."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログアウトして、この端末にある現在のプロフィールのローカルデータを削除します。この端末上の他のローカルプロフィールは保持されます。"
          }
        }
      }
    },
    "management.managementauth.youWillBeSignedOutOfMistia": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn sẽ bị đăng xuất khỏi Mistia trên thiết bị này. Dữ liệu local hiện có vẫn được giữ lại."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You will be signed out of Mistia on this device. Existing local data will stay on the device."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末でミスティアからログアウトします。既存のローカルデータは保持されます。"
          }
        }
      }
    },
    "management.managementauth.yourAccountIsWaitingForEmailConfirmation": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài khoản của bạn đang chờ xác nhận email trước khi có thể đăng nhập và bật đồng bộ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account is waiting for email confirmation before it can sign in and start syncing."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントはメール確認が完了するまでログインと同期を開始できません。"
          }
        }
      }
    },
    "management.managementauth.yourBirthdayCanHelpPersonalizeFutureExperiences": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngày sinh giúp cá nhân hóa trải nghiệm trong tương lai, ví dụ các nhắc nhở hoặc thiết lập phù hợp với độ tuổi. Bạn có thể cập nhật lại bất kỳ lúc nào."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your birthday can help personalize future experiences such as reminders or age-appropriate settings. You can update it anytime."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "生年月日は、将来のリマインダーや年齢に応じた設定などを個人化するために利用される場合があります。いつでも変更できます。"
          }
        }
      }
    },
    "management.managementauth.yourCloudAccountAndSyncedServerData": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài khoản và dữ liệu đồng bộ trên cloud sẽ bị xóa vĩnh viễn. Dữ liệu local trên máy này vẫn được giữ lại."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your cloud account and synced server data will be permanently deleted. Local data on this device will remain."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラウドアカウントと同期済みサーバーデータは完全に削除されます。この端末のローカルデータは保持されます。"
          }
        }
      }
    },
    "management.managementauth.yourDataIsCurrentlyFullySyncedNo": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện tại dữ liệu của bạn đã được đồng bộ hoàn toàn, không có bất đồng bộ nào cần xử lý."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your data is currently fully synced, no conflicts need attention."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在、データは完全に同期されており、解決が必要な競合はありません。"
