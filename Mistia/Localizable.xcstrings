    "management.managementauth.yourBirthdayCanHelpPersonalizeFutureExperiences" : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ngày sinh giúp cá nhân hóa trải nghiệm trong tương lai, ví dụ các nhắc nhở hoặc thiết lập phù hợp với độ tuổi. Bạn có thể cập nhật lại bất kỳ lúc nào."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your birthday can help personalize future experiences such as reminders or age-appropriate settings. You can update it anytime."
