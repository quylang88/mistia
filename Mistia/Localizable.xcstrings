    "core.ui.mistiacategorypicker.afterYouUseCategoriesAFewTimes": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sau khi bạn dùng danh mục vài lần, Mistia sẽ đưa các mục xuất hiện nhiều nhất vào đây."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After you use categories a few times, Mistia will surface the most-used ones here."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カテゴリを数回使うと、ミスティアがよく使う項目をここに表示します。"
          }
        }
      }
    },
