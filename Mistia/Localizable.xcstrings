    "app.roottab.transfersBetweenSourcesWillBeConnectedHere": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Flow chuyển tiền giữa các nguồn sẽ được nối tại đây sau. Menu popout mới đã tách sẵn action riêng cho màn này."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transfers between sources will be connected here next. The new popout menu already separates the action for this screen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "資金移動フローはここに後で接続されます。この画面用のアクションは新しいポップアウトメニューですでに分かれています。"
          }
        }
      }
    },
    "app.roottab.youDoNotHaveUseAccessTo": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn chưa có quyền sử dụng ví của thành viên này."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You do not have use access to this member's wallets."
