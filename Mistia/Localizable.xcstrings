    "investment.permission.requestPendingMessage" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The permission request is waiting for the investment portfolio owner's approval."}},"ja":{"stringUnit":{"state":"translated","value":"権限リクエストは投資ポートフォリオ所有者の承認待ちです。"}},"vi":{"stringUnit":{"state":"translated","value":"Yêu cầu quyền đang chờ chủ danh mục đầu tư phê duyệt."}}}},
