    "investment.permission.sendFailedMessage" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Couldn't send the permission request right now."}},"ja":{"stringUnit":{"state":"translated","value":"現在、権限リクエストを送信できません。"}},"vi":{"stringUnit":{"state":"translated","value":"Không thể gửi yêu cầu quyền lúc này."}}}},
