{
  "sourceLanguage": "vi",
  "strings": {
    "app.mistia.loadingYourData": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang tải dữ liệu..."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading your data..."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データを読み込み中..."
          }
        }
      }
    },
    "app.mistia.localDataHasBeenKeptOnThis": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dữ liệu local vẫn được giữ nguyên trên máy"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local data has been kept on this device"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルデータはこの端末に保持されています"
          }
        }
      }
    },
    "app.mistia.mistiaIsProtectingYourData": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mistia đang bảo vệ dữ liệu của bạn"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mistia is protecting your data"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ミスティアはデータを保護しています"
          }
        }
      }
    },
    "app.mistia.switchingSession": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang chuyển phiên..."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switching session..."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セッションを切り替えています..."
          }
        }
      }
    },
    "app.mistia.technicalDetails": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chi tiết kỹ thuật"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Technical details"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "技術的な詳細"
          }
        }
      }
    },
    "app.mistia.theAppCouldnTOpenTheLocal": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng không thể mở cơ sở dữ liệu cục bộ sau khi cập nhật. Mistia đã chuyển sang chế độ an toàn và không xóa dữ liệu trên máy."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app couldn't open the local database after the update. Mistia switched to safe mode and did not delete the data on this device."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデート後にローカルデータベースを開けなかったため、ミスティアはセーフモードに切り替わり、この端末のデータは削除していません。"
          }
        }
      }
    },
    "app.mistia.theAppWillNotCreateAReplacement": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "App sẽ không tự tạo DB mới để tránh ghi đè hoặc đồng bộ nhầm"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app will not create a replacement database that could overwrite or sync bad state"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上書きや誤同期を防ぐため、代わりのデータベースは自動作成しません"
          }
        }
      }
    },
    "app.mistianativetab.quickCreate": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tạo nhanh"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quick create"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クイック作成"
          }
        }
      }
    },
    "app.roottab.captureAmountAndTypeFirstThenComplete": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ nhập số tiền và loại để hoàn thiện sau."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture amount and type first, then complete later."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "金額と種類だけ先に入れて、あとで詳細を整えます。"
          }
        }
      }
    },
    "app.roottab.chooseAReceiptImageSourceForAI": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn nguồn ảnh bill để AI phân tích."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a receipt image source for AI analysis."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AI解析に使うレシート画像の取得方法を選択します。"
          }
        }
      }
    },
    "app.roottab.chooseCameraOrPhotoUploadForAI": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn chụp hoặc tải ảnh bill để AI điền thu chi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose camera or photo upload for AI receipt fill."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "撮影または写真選択でAIが取引を入力します。"
          }
