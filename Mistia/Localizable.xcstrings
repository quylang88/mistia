    "investment.error.missingAsset" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This asset no longer exists."}},"ja":{"stringUnit":{"state":"translated","value":"この資産は存在しません。"}},"vi":{"stringUnit":{"state":"translated","value":"Tài sản này không còn tồn tại."}}}},
    "investment.error.missingWallet" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Please select an available wallet."}},"ja":{"stringUnit":{"state":"translated","value":"利用可能なウォレットを選択してください。"}},"vi":{"stringUnit":{"state":"translated","value":"Vui lòng chọn một ví khả dụng."}}}},
    "investment.error.invalidWallet" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This wallet cannot be used for this investment operation."}},"ja":{"stringUnit":{"state":"translated","value":"このウォレットはその投資操作には使用できません。"}},"vi":{"stringUnit":{"state":"translated","value":"Ví này không thể dùng cho thao tác đầu tư đó."}}}},
    "investment.error.insufficientFunds" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The selected wallet has insufficient available funds."}},"ja":{"stringUnit":{"state":"translated","value":"選択したウォレットの残高が不足しています。"}},"vi":{"stringUnit":{"state":"translated","value":"Số dư trong ví đã chọn không đủ để thực hiện giao dịch."}}}},
    "investment.error.invalidTradeInput" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The investment transaction data is invalid."}},"ja":{"stringUnit":{"state":"translated","value":"投資取引データが無効です。"}},"vi":{"stringUnit":{"state":"translated","value":"Thông tin giao dịch đầu tư không hợp lệ."}}}},
    "investment.error.missingExchangeRate" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"An exchange rate snapshot is required for this transaction."}},"ja":{"stringUnit":{"state":"translated","value":"この取引には為替レートのスナップショットが必要です。"}},"vi":{"stringUnit":{"state":"translated","value":"Cần tỷ giá hối đoái để thực hiện giao dịch này."}}}},
    "investment.error.cannotTransferIn" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Funds cannot be transferred directly into the Investment Wallet."}},"ja":{"stringUnit":{"state":"translated","value":"投資ウォレットに直接振替することはできません。"}},"vi":{"stringUnit":{"state":"translated","value":"Không thể chuyển trực tiếp tiền vào Ví Đầu tư."}}}},
    "investment.error.closePositionsBeforeArchive" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Please close or sell all holdings before archiving."}},"ja":{"stringUnit":{"state":"translated","value":"アーカイブする前にすべての保有資産を売却・決済してください。"}},"vi":{"stringUnit":{"state":"translated","value":"Vui lòng tất toán toàn bộ vị thế tài sản trước khi lưu trữ."}}}},
