    "management.managementauth.createAMistiabackupFileToCaptureThe": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tạo file `.mistiabackup` để lưu lại toàn bộ dữ liệu local hiện tại. Khi nhập lại snapshot, Mistia chỉ khôi phục local trước và sẽ không tự đẩy lên cloud cho tới khi bạn tự bấm Đồng bộ ngay."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a `.mistiabackup` file to capture the current local state. When you restore it, Mistia updates local data first and won't push to the cloud until you manually tap Sync now."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のローカル状態を `.mistiabackup` ファイルとして保存できます。復元時はまずローカルデータだけを更新し、手動で「今すぐ同期」を押すまでクラウドへは自動送信しません。"
          }
        }
      }
    },
