    "app.roottab.quickCaptureIsForUltraLightEntries": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi nhanh sẽ dùng cho những entry cần capture thật gọn. Trước mắt đây là placeholder để bạn duyệt layout và nhịp mở menu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quick capture is for ultra-light entries. For now this is a placeholder so you can review layout and menu timing."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クイック入力は最小限の記録向けです。今はレイアウトとメニューの開き方を確認するためのプレースホルダーです。"
          }
        }
      }
    },
    "app.roottab.quickNote": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi nhanh"
