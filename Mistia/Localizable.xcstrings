    "management.managementauth.autoSyncIsOffYourDataWill" : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tự động đồng bộ đang tắt. Dữ liệu của bạn sẽ chỉ được cập nhật khi bạn nhấn nút 'Đồng bộ ngay' một cách thủ công. Bật tính năng này để đảm bảo dữ liệu luôn được cập nhật mới nhất trên mọi thiết bị."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto sync is off. Your data will only update when you manually tap the 'Sync now' button. Enable this feature to keep your data up to date across all your devices automatically."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動同期はオフです。データは「今すぐ同期」ボタンを手動で押したときにのみ更新されます。すべてのデバイスでデータを最新の状態に保つには、この機能を有効にしてください。"
          }
        }
      }
    },
    "management.managementauth.autoSyncIsPausedAfterTheRestore" : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tự động sync đang tạm dừng sau khi khôi phục snapshot. Khi bạn đã kiểm tra dữ liệu ổn, hãy vào Đồng bộ dữ liệu và nhấn Đồng bộ ngay."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto sync is paused after the restore. Once you've reviewed the data, open Sync settings and tap Sync now."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スナップショット復元後は自動同期を停止しています。データ確認後に同期設定へ移動して「今すぐ同期」を押してください。"
