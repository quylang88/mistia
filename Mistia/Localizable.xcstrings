    "investment.permission.managementMessage" : {"localizations":{"en":{"stringUnit":{"state":"translated","value":"You do not have permission to manage this investment portfolio. Request management access from the data owner."}},"ja":{"stringUnit":{"state":"translated","value":"この投資ポートフォリオを管理する権限がありません。データ所有者に管理権限をリクエストしてください。"}},"vi":{"stringUnit":{"state":"translated","value":"Bạn chưa có quyền quản lý danh mục đầu tư này. Hãy yêu cầu quyền quản lý từ chủ dữ liệu."}}}},
