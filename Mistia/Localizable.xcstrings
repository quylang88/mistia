    "settings.resetData.deleteAllData.confirmationMessage": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mistia chỉ xóa dữ liệu local trên thiết bị này. Đăng nhập, hồ sơ cloud và gia đình vẫn được giữ."
