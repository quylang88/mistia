    "settings.notifications.family.description": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thông báo gia đình gồm yêu cầu quyền, thay đổi quyền và hoạt động tài chính từ các thành viên được chia sẻ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Family notifications include permission requests, permission changes, and shared financial activity from members."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "家族通知には、権限リクエスト、権限変更、共有された家族の財務アクティビティが含まれます。"
          }
        }
      }
    },
