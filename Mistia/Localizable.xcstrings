    "settings.notifications.enable.description": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi bật, Mistia có thể gửi thông báo nhắc nhở quan trọng."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When enabled, Mistia can send important reminders."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効にすると、ミスティアから重要なリマインダー通知が届きます。"
          }
        }
      }
    },
    "settings.notifications.enable.title": {
