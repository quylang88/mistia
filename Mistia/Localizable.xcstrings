    "shared.session.session.thisDeviceIsBackToAClean2": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dữ liệu trên thiết bị này đã về trạng thái ban đầu. Cloud, đăng nhập và gia đình vẫn được giữ; hãy bấm Đồng bộ ngay nếu muốn tải lại dữ liệu cloud."
          }
        },
        "en": {
          "stringUnit": {
