          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クイック入力"
          }
        }
      }
    },
    "app.roottab.receiptScanOpensTheTransactionModalAnd": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quét bill sẽ mở modal thu chi và tự điền thông tin đọc được từ ảnh."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Receipt scan opens the cashflow item modal and fills details from the image."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レシート読取は取引モーダルを開き、画像から読み取った内容を入力します。"
          }
        }
      }
    },
    "app.roottab.recordIncomeToUpdateYourBalance": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi nhận nguồn thu để cập nhật số dư."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record income to update your balance."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残高を更新するための収入を記録します。"
          }
        }
      }
    },
    "app.roottab.saveAnExpenseFromAPersonalWallet": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
